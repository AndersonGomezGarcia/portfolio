---
import type { GetStaticPaths } from "astro";
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/alter/Header.astro";
import Description from "../../../components/alter/Description.astro";
import Footer from "../../../components/alter/Footer.astro";
import data from "../../../data/en/projects.json";
import BackButton from "../../../components/elements/BackButton.astro";
import MainData from "../../../data/en/main.json";


export const getStaticPaths = (() => {
    const paths = data.projects.map((project) => ({
        params: { project: project.key },
    }));
    return paths;
}) satisfies GetStaticPaths;

const { project } = Astro.params;
const projectData = data.projects.find((p) => p.key === project ) || {
    title: "Proyecto no encontrado",
    description: [{ type: "text", value: "No se encontró el proyecto." }],
    image: "img/not-found.png",
    key: project,
};

---
<Layout lan="en">
    <BackButton />
    <Header class="fade-up" project={projectData} />
    <Description project={projectData} maindata={MainData} />
</Layout>
<Footer project={projectData} />

<style>
    body {
        padding-bottom: 0;
    }
</style>