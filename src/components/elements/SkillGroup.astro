---
const { Group, items, tags } = Astro.props;
---

<div id={Group} class="SkillGroup fade-up">
  <div id={Group}>
    <h3>{Group}</h3>
    <div id={Group + "-Items"} class="SkillGroup-Items">
      <ul>
        {
          items.map((item: keyof typeof items) => (
            <li>
              <img src={item} alt={item} />
              <span>{tags[items.indexOf(item)]}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</div>
<style>
    .SkillGroup{
      width: 100%;
      display: flex;
      justify-content: center;

    }
    .SkillGroup h3 {
        font-size: 25px;
        font-weight: 400;
        font-family: "Roboto";
        color: #00d2ff;
        color: white;
        margin: 40px auto 0 auto;
        text-align: center;
    }
    .SkillGroup-Items {
      display: inline-flex;
      background-color: var(--containerBg);

      color: white;
      border: solid 1px #ffffff1f;
      border-radius: 40px;
      padding: 20px 30px;
      margin: 20px auto 0 auto;
      width: auto;
      max-width: 100%;
      transition: 0.4s;
    }
    .SkillGroup-Items:hover{
        border: solid 1px #03BCE4;
    transition: .2s;
    padding: 20px;
    max-width: calc(100% - 30px);
    background-color: rgba(0, 133, 173, 0.1);
    }
    .SkillGroup ul {
        display: flex;
        justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
    margin: auto;
    padding: 0;
    color: white;
    width: auto;
    max-width: 700px;
    list-style: none;
  }

  .SkillGroup ul li {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    position: relative;
    gap: 5px;
    font-weight: 400;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.75);
    text-align: center;
  }

  .SkillGroup ul li img {
    display: block;
    height: 57.5px;
    width: fit-content;
    margin: 0;
    padding: 0;
    transition: 0.3s;
  }

  .SkillGroup ul li img:hover {
    filter: brightness(
      1.4
    ); /* Ajusta el valor según el nivel de brillo deseado */
    transition: 0.2s; /* Añade una transición suave */
    transform: translate(0, -8px);
  }
</style>
 