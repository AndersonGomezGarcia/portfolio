---
const { title } = Astro.props;
const { beforeTitle } = Astro.props;
---

<h1><span>{beforeTitle}</span>{title}</h1>
<style>
h1 {
    margin: 100px auto 0 0;
  }

  h1 span {
    font-size: var(--paragraph-font-size, 20px);
    font-weight: 400;
    font-family: "Roboto";
    color: #00d2ff;
    position: relative;
    margin: 0 0 0 0px;
    display: block;
  }

  h1 span:before{
    content: " ";
    display: inline-block;
    width: 8px;
    height: 5px;
    border-radius: 5px;
    background-color: #00d2ff;
    margin-right: 5px;
    vertical-align: middle;
    bottom: calc(50% - 2.5px);
  }

  h1 {
    font-size: 50px;
    font-weight: 600;
    font-family: "Roboto";
    color: #00d2ff;
    color: white;
    transition: 0.4s;
    padding: 20px 0 0 0;
  }

  h1:hover {
    color: white;
    transition: 0.2s;
  }
h1:hover {
    white-space: 10px;
    text-indent: 20px;
    transition: 0.2s;
    text-shadow: #00d0ff7a 1px 1px 05px;
  }
</style>
