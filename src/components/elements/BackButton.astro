---
const baseUrl = import.meta.env.BASE_URL;
---

<button onclick="history.back(); return false;" class="BackButton">
  <a href="/"> <img src={`${baseUrl}img/icons/back.png`} alt="Back" /> Back</a>
</button>

<style>
  .BackButton {
    position: fixed;
    top: 20px;
    left: 20px;
    background-color: #373a46;
    color: #00a6ca;
    border: none;
    padding: 10px 20px;
    font-size: 16px;
    cursor: pointer;
    border-radius: 5px;
    text-decoration: none;
    border: solid 1px transparent;
    z-index: 5;
  }
  .BackButton:hover {
    background-color: #2c2e37;
    color: #00d2ff;
    border: solid 1px #00d2ff;
    transition:
      background-color 0.3s,
      color 0.3s;
  }
  .BackButton:hover img {
    filter: brightness(1.2);
    transition: filter 0.3s;
  }

  .BackButton a {
    color: inherit;
    text-decoration: none;
  }

  .BackButton img {
    margin-right: 5px;
    padding: 0;
    height: 18px;
    width: 18px;
  }
</style>
