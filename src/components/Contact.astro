---
import Title from "../components/elements/Title.astro";
---

<div id="Contact" class="fade-up">
  <Title title="Contacto" beforeTitle="Hazme" />
  <br>
  <div class="Separator"></div>
  <div id="Contact-Items" >
    <div id="Contact-Info" class="fade-up">
      <img class="Contact-IMG" src="img/icons/contact.png" alt="" />
      <h2>Anderson Gomez Garcia</h2>
      <p class="copyable">
        andersongomezgarcia111<wbr />@gmail.com <img
          class="Copy"
          src="img/copy.png"
          alt="copy icon"
        />
      </p>
      <p class="copyable">
        <img src="img/icons/colombia.svg" alt="" /> +57 3185836788 <img
          class="Copy"
          src="img/copy.png"
          alt="copy icon"
        />
      </p>
      <p class="copyable">
        Tulúa, Valle del Cauca, Colombia <img
          class="Copy"
          src="img/copy.png"
          alt="copy icon"
        />
      </p>
    </div>
    <div id="Contact-Form" class="fade-up">
      <form id="Form-to-Contact">
        <input type="text" id="name" placeholder="Nombre" required />
        <input type="email" id="email" placeholder="Correo" required />
        <textarea
          name=""
          id="message"
          cols="30"
          rows="10"
          placeholder="Mensaje"
          required></textarea>
        <button type="submit">Enviar</button>
      </form>
    </div>
  </div>
</div>
<div id="CopyPopup" class="CopyPopup">Texto copiado</div>

<script type="module">
  function toggleMenu() {
    if (window.innerWidth <= 768) {
      // Verifica si el ancho de la pantalla es menor o igual a 768px

      var menu = document.getElementById("nav-menu"); /*as HTMLElement | null*/
      var hamburger =
        document.getElementById("hamburger"); /* as HTMLElement | null*/

      if (menu && hamburger) {
        if (menu.style.display === "block") {
          menu.style.display = "none";
          hamburger.innerHTML = "☰ Menu";
        } else {
          menu.style.display = "block";
          hamburger.innerHTML = "✖ Close";
        }
      }
    }
  }

  function copyToClipboard(element /*: HTMLElement*/) {
    const text = element.innerText || element.textContent;
    const tempInput = document.createElement("input");
    tempInput.style.position = "absolute";
    tempInput.style.left = "-9999px";
    tempInput.value = text || "";
    document.body.appendChild(tempInput);
    tempInput.select();
    document.execCommand("copy");
    document.body.removeChild(tempInput);
    const popup = document.getElementById("CopyPopup");
    if (!popup) return;
    popup.classList.add("Show");

    // Ocultar el popup después de 3 segundos
    setTimeout(() => {
      popup.classList.remove("Show");
    }, 1000);
  }

  document.querySelectorAll(".copyable").forEach((el) => {
    el.addEventListener("click", async () => {
      const text = el.innerText.trim();

      try {
        await navigator.clipboard.writeText(text);
        showCopyPopup();
      } catch (err) {
        console.error("Error al copiar al portapapeles:", err);
      }
    });
  });

  function showCopyPopup() {
  const popup = document.getElementById("CopyPopup");
  if (!popup) return;

  if (popup.classList.contains("Show")) {
    popup.classList.remove("Show");

    // Espera un momento para que pueda reiniciarse la animación
    setTimeout(() => {
      popup.classList.add("Show");
    }, 10);
  } else {
    popup.classList.add("Show");
  }

  // Ocultar el popup después de 3 segundos
  setTimeout(() => {
    popup.classList.remove("Show");
  }, 1250);
}

  const formElement = document.getElementById("Form-to-Contact");
  if (formElement) {
    formElement.addEventListener("submit", function (event) {
      event.preventDefault(); // Evita el envío del formulario

      const name =
        document.getElementById("name") /*as HTMLInputElement*/.value;
      const email =
        document.getElementById("email") /*as HTMLInputElement*/.value;
      const message =
        document.getElementById("message") /*as HTMLTextAreaElement*/.value;

      const mailtoLink = `mailto:andersongomezgarcia111@gmail.com?subject=Contacto de ${name}&body=Nombre: ${name}%0AEmail: ${email}%0AMensaje: ${message}`;

      window.location.href = mailtoLink;
    });
  }
</script>
<style>

  .copyable {
    cursor: pointer;
    position: relative;
  }
  .CopyPopup {
    position: fixed;
    bottom: 20px;
    right: 20px;
    background-color: #03bbe4a4;
    color: white;
    padding: 10px 20px;
    border-radius: 5px;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    opacity: 0;
    border: solid 1px #ffffff1f;
    visibility: hidden;
    transition:
      opacity 1.5s,
      visibility 0.5s
      1s;
    z-index: 1000;
    backdrop-filter: blur(5px);
    
  }

  .CopyPopup.Show {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.5s ease-in-out,
      visibility 0.5s ease-in-out;
    animation: jump-shaking 0.5s ease-in-out;
  }

  #Contact-Items {
    display: inline-flex;
  }
  #Contact-Info {
    display: flex;
    margin: 125px 0 0 0;
    padding: 40px;
    color: white;
    flex-direction: column;
    border: solid 1.5px #ffffff1f;
    background-color: var(--containerBg);

    border-radius: 25px;
    width: calc(41% - 70px);
    height: min-content;
    position: relative;
    transition: 0.3s;
  }

  #Contact-Info:hover {
    border: solid 1.5px #03bce4;
    transition: 0.2s;
    background-color: rgba(0, 133, 173, 0.1);
    border-radius: 35px;
    transform: translate(0, -10px);
  }

  #Contact-Info h2 {
    font-size: 45px;
    font-weight: 600;
    font-family: "Roboto";
    color: white;
    transition: 0.4s;
    margin: 0 0 15px 0;
  }

  #Contact-Info p {
    font-size: 21px;
    font-weight: 400;
    font-family: "Roboto";
    color: white;
    margin: 0 0 25px 0;
    padding: 5px;
    opacity: 0.75;
  }
  #Contact-Info p img.Copy {
    opacity: 0;
    transition: 0.1s;
  }
  #Contact-Info p:hover img.Copy {
    opacity: 1;
    transition: 0.1s;
    filter: brightness(1.2);
    animation: horizontal-shaking 0.5s ease-in-out;
  }

  #Contact-Info img {
    height: 100px;
    margin: 0 10px 0 0;
    position: absolute;
    top: -120px;
    right: calc(50% - 50px);
  }
  #Contact-Info p img {
    height: 20px;
    margin: 0 10px 0 0;
    top: 0;
    position: relative;
    right: 0;
  }

  #Contact-Form {
    width: 54%;
    margin: 0 0 0 auto;
  }

  #Contact-Form form {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    gap: 20px;
    transition: 0.3s;
  }

  #Contact-Form form input,
  #Contact-Form form textarea {
    border: solid 1px #ffffff1f;
    border-radius: 15px;
    padding: 10px 20px 10px 55px;
    background-color: #2c2d32;
    background-color: var(--containerBg);

    font-family: "Roboto";
    font-size: 20px;
    margin: 0px;
    font-weight: 600;
    transition: 0.4s;
    width: 100%;
    color: #00b9ec;
  }
  #Contact form textarea {
    padding-top: 30px;
  }

  #Contact-Form form input::placeholder,
  #Contact-Form form textarea::placeholder {
    color: #c0c0c0;
    font-family: "Roboto";
    font-size: 18px;
    font-weight: 600;
  }

  #Contact-Form form input:focus,
  #Contact-Form form textarea:focus {
    border: solid 1px #03bce4;
    transition: 0.2s;
  }

  #Contact-Form form button {
        background: linear-gradient(to right,#0481d4, #00a5ce);

    border: none;
    padding: 10px 45px;
    color: #27282c;
    text-decoration: none;
    font-weight: 600;
    border-radius: 18px;
    font-family: "Roboto Mono";
    font-size: 20px;
    color: white;
    transition: 0.3s;
    float: left;
    margin: 0 auto 0 0;
  }

  #Contact-Form form button:hover {
    background-color: #03bce4;
    color: white;
    cursor: pointer;
    transition: 0.3s;
  }
  @keyframes float {
    0% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
    100% {
      transform: translateY(0);
    }
  }

  .Contact-IMG {
    animation: float 1.5s ease-in-out infinite; /* Aplica la animación de flotación */
  }

  @media (max-width: 768px) {
    #Contact-Items {
      display: flex;
      justify-content: center;
      align-items: center;
      flex-wrap: wrap;
      margin: 0;
      padding: 0;
      color: white;
      gap: 20px;
    }

    #Contact-Info {
      display: flex;
      padding: 40px;
      color: white;
      flex-direction: column;
      border-radius: 25px;
      width: 100%;
      height: min-content;
      position: relative;
      transition: 0.3s;
    }

    #Contact-Form {
      width: 100%;
      margin: 0 0 0 auto;
    }

    footer {
      width: 86%;
      padding: 10px 7% 5px 7%;
    }
  }
  @keyframes jump-shaking {
    0% {
      transform: translateX(0);
    }
    25% {
      transform: translateY(-9px);
    }
    35% {
      transform: translateY(-9px) rotate(10deg);
    }
    55% {
      transform: translateY(-9px) rotate(-10deg);
    }
    65% {
      transform: translateY(-9px) rotate(10deg);
    }
    75% {
      transform: translateY(-9px) rotate(-10deg);
    }
    100% {
      transform: translateY(0) rotate(0);
    }
  }

  @keyframes horizontal-shaking {
 0% { transform: translateX(0) }
 25% { transform: translateX(3px) }
 50% { transform: translateX(-3px) }
 75% { transform: translateX(3px) }
 100% { transform: translateX(0) }
}
@media (max-width: 768px) {
    #Contact-Info {
  width: calc(100% - 80px);
    }

  }


</style>
