---
import type { arrayOutputType } from "astro:schema";
import Title from "../components/elements/Title.astro";
const route = "img/projects/";
import githubIcon from '../img/github-mark.svg';
import getUrls from "../utils/urls.js";
import def_data from "../data/main.json";
import en_data from "../data/en/main.json";
import es_data from "../data/es/main.json";
import def_projects from "../data/projects.json";
import en_projects from "../data/en/projects.json";
import es_projects from "../data/es/projects.json";
import {globalUrl} from "../utils/urls.js";

const { lan } = Astro.props;

let data;
if (lan) {
  if (lan === "en") {
    data = en_data;
  } else {
    data = es_data;
  }

}else{
  data = def_data;
}

let projects;
let language;

if (lan) {
  if (lan === "en") {
    projects = en_projects;
    language = "en";
  } else {
    projects = es_projects;
    language = "es";

  }

}else{
  projects = def_projects;
  language = "es";
}

/*
interface Project {
    title: string;
    pretitle: string;
    image: string;
    description: string;
    skills: string[];
    links: {
        url?: string;
        github?: string;
        download?: string;
    };
}*/
// Define the Project type based on your data structure
const { complete, nested } = Astro.props;

type Project = {
  key: string;
  name: string;
  tagline: string;
  image: string;
  summary: string;
  tecnologies: string[];
  description: Record<string, any>[];
  links: {
    url?: string;
    github?: string;
    download?: string;
  };
};
type Projects = Project[];

const selectedKeyProyects: string[] = [
  "WeekArtApp",
  "digitcol",
  "pool-care",
  "hotel-el-descanso",
];

let selectedProjects: Projects;

if (!complete) {
  // If not complete, filter projects to only include selected ones
  selectedProjects = projects.projects.filter((item) =>
    selectedKeyProyects.includes(item.key)
  );
} else {
  selectedProjects = projects.projects;
}
selectedProjects.reverse(); // Reverse the order of projects for display
const baseUrl = nested === "true" ? "../" : "";
---

<section id="Projects" class="fade-up section">
  <Title title={data.projects.title} beforeTitle={data.projects.pretitle} />
  <div class="Separator"></div>
  <div id="Projects-Items">
    {
      selectedProjects.map((item) => {
        return (
          <div class="Project fade-up">
            <img
              class="Project-Image"
              src={`${globalUrl + item.image}`}
              alt={item.name}
            />
            <div class="Content">
              <h3>{item.name}</h3>
              <p>{item.summary}</p>
              <div class="header">
                <ul class="Skills">
                  {item.tecnologies.map((skill) => (
                    /*
                    <li data-skill={skill} >
                      {skill}
                    </li>
                    */

                    <li data-skill={skill}>
                      <img src={globalUrl + '/'+baseUrl + getUrls(skill)} alt={skill} />
                    </li>
                  ))}
                </ul>
                <div class="Links">
                  <a class="details" href={globalUrl + './' + language + "/projects/" + item.key}>
                    {data.projects.moreDetails}{" "}
                    <span style="  font-family: 'WDXL Lubrifont TC', sans-serif">
                      {" "}
                      →
                    </span>
                  </a>
                  {item.links.github && (
                    <a href={item.links.github} target="_blank">
                      <svg width="98" height="96"  viewBox="0 0 98 96" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M48.854 0C21.839 0 0 22 0 49.217c0 21.756 13.993 40.172 33.405 46.69 2.427.49 3.316-1.059 3.316-2.362 0-1.141-.08-5.052-.08-9.127-13.59 2.934-16.42-5.867-16.42-5.867-2.184-5.704-5.42-7.17-5.42-7.17-4.448-3.015.324-3.015.324-3.015 4.934.326 7.523 5.052 7.523 5.052 4.367 7.496 11.404 5.378 14.235 4.074.404-3.178 1.699-5.378 3.074-6.6-10.839-1.141-22.243-5.378-22.243-24.283 0-5.378 1.94-9.778 5.014-13.2-.485-1.222-2.184-6.275.486-13.038 0 0 4.125-1.304 13.426 5.052a46.97 46.97 0 0 1 12.214-1.63c4.125 0 8.33.571 12.213 1.63 9.302-6.356 13.427-5.052 13.427-5.052 2.67 6.763.97 11.816.485 13.038 3.155 3.422 5.015 7.822 5.015 13.2 0 18.905-11.404 23.06-22.324 24.283 1.78 1.548 3.316 4.481 3.316 9.126 0 6.6-.08 11.897-.08 13.526 0 1.304.89 2.853 3.316 2.364 19.412-6.52 33.405-24.935 33.405-46.691C97.707 22 75.788 0 48.854 0z"/></svg>
                    </a>
                  )}
                  {item.links.url && (
                    <a href={item.links.url} target="_blank">
                      <svg xmlns="http://www.w3.org/2000/svg"  viewBox="0 0 48 48" width="96px" height="96px"><path d="M 40.960938 4.9804688 A 2.0002 2.0002 0 0 0 40.740234 5 L 28 5 A 2.0002 2.0002 0 1 0 28 9 L 36.171875 9 L 22.585938 22.585938 A 2.0002 2.0002 0 1 0 25.414062 25.414062 L 39 11.828125 L 39 20 A 2.0002 2.0002 0 1 0 43 20 L 43 7.2460938 A 2.0002 2.0002 0 0 0 40.960938 4.9804688 z M 12.5 8 C 8.3826878 8 5 11.382688 5 15.5 L 5 35.5 C 5 39.617312 8.3826878 43 12.5 43 L 32.5 43 C 36.617312 43 40 39.617312 40 35.5 L 40 26 A 2.0002 2.0002 0 1 0 36 26 L 36 35.5 C 36 37.446688 34.446688 39 32.5 39 L 12.5 39 C 10.553312 39 9 37.446688 9 35.5 L 9 15.5 C 9 13.553312 10.553312 12 12.5 12 L 22 12 A 2.0002 2.0002 0 1 0 22 8 L 12.5 8 z"/></svg>
                    </a>
                  )}
                  {item.links.download && (
                    <a href={item.links.download} target="_blank">
                      <img
                        class="hyperlink"
                        src={`${globalUrl + baseUrl}img/download.png`}
                        alt=""
                      />
                    </a>
                  )}
                </div>
              </div>
            </div>
          </div>
        );
      })
    }
    {
      !complete && (
        <a class="moreProjects fade-up" href="./projects">
          {data.projects.moreProjects}
        </a>
      )
    }
  </div>
</section>

<style>

  div#Projects:target {
    scroll-margin-top: 120px!important;
  }
  #Projects-Items {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    flex-wrap: wrap;
    margin: 0;
    padding: 10px 10px 50px;
    color: white;
    gap: 55px 7%;
  }

  .Project {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    width: 44%;
    margin: 0;
    overflow: hidden;
    padding: 0;
    background: #2e2f35; /* Gradiente lineal en diagonal */
    background-color: var(--containerBg);
    border-radius: var(--containerBR);
    color: white;
    flex-direction: column;
    box-shadow:
      rgba(0, 0, 0, 0.24) 0px 0px 2px 0px,
      rgba(0, 0, 0, 0.28) 0px 2px 4px 0px;
    transition:
      transform 0.2s,
      border 0.2s,
      background-color 0.2s;
    border: solid 1px #ffffff1f;
  }


  .Project:hover {
    transform: translateY(-12px);
    border: solid 1px #03bce4;
    box-shadow:
      0 0 24px 0 #00b7ff0e,
      0 2px 24px 0 #00b7ff0e;

    background-color: rgba(0, 133, 173, 0.15);
  }

  @keyframes throb {
    0%,
    100% {
      transform: scale(1);
      filter: brightness(1);
    }
    25%,
    75% {
      transform: scale(1.1);
      filter: brightness(1.05);
    }
    50% {
      transform: scale(1.2);
      filter: brightness(1.1);
    }
  }

  .Project:hover img.hyperlink {
    filter: brightness(
      1.2
    ); /* Ajusta el valor según el nivel de brillo deseado */
    /* animation: throb 0.65s ease-in infinite; /* Añade una transición suave */
  }

  .Project .Content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: calc(100% - 60px);
    padding: 15px 30px;
  }
  /* .Project .Content h3 {
    color: #00b7ff;
  } */


  .Project img {
    width: 90%;
    height: auto;
    border-radius: 25px;
    display: flex;
    margin: 0 0 0;
  }

  .Project img.Project-Image {
    border-radius: 10px;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.2);
    width: calc(100% - 30px);
    transition: 0.3s ease-in-out;
    overflow: hidden;
    margin-top: 15px;
    display: block;
    /* Ensure the image fills the container but doesn't scale itself */
    object-fit: cover;
    will-change: transform;
  }

  .Project:hover .Project-Image {
    /* Scale the parent .Project, not the image itself */
    filter: brightness(1.08) saturate(1.1);
    transition: 0.3s;
  }

  .Project:hover {
    /* Scale the whole project card, including the image */
    transform: scale(1.02);
    transition: 0.2s;
  }

  .Project .header {
    height: auto;
    display: flex;
    flex-direction: column;
    width: 100%;
    bottom: 0;
    gap: 10px;
  }

  .Project h3 {
    margin: 5px auto 0 0;
    font-size: 25px;
    color: rgb(255, 255, 255);
  }

  .Project .Skills {
    display: flex;
    justify-content: left;
    align-items: center;
    flex-wrap: wrap;
    margin: 0 auto 0 0;
    padding: 0;
    color: white;
    gap: 15px;
  }

  .Project .Skills li {
    position: relative;
    list-style-type: none;
  }



  .Project .Skills li img,
  .Project .Links img {
    height: 35px;
    width: auto;
    margin: 0;
    padding: 0;
    transition: 0.3s;
    filter: grayscale(1);
    transition: 0.2s;
    z-index: 2;
  }

  .Project .Skills li::before {
    display: block;
    content: attr(data-skill);
    position: absolute;
    top: -8px;
    left: 50%;
    transform: translateX(-50%) scale(0.2);
    color: rgb(0, 174, 255);
    background-color: #1e1f22;
    overflow: hidden;
    padding: 5px 10px;
    border-radius: 10px;
    font-size: 14px;
    pointer-events: none;
    transition: 0.4s;
    font-weight: 700;
    opacity: 0;
    z-index: 1;
  }

  .Project .Skills li:hover::before {
    opacity: 1;
    top: -32px;
    transition: 0.3s;
    transform: translateX(-50%) scale(1);
  }

  .Project .Skills li img:hover {
    filter: brightness(1.4);
    transition: 0.2s;
  }

  .Project .Links img {
    border-radius: 0;
  }

  .Project .Links img {
    width: 32px;
    height: 32px;
    fill: #00b7ff;
    transition: 0.3s;
    filter: brightness(1.2);
  }

  .Project .Links {
    display: flex;
    justify-content: left;
    align-items: center;
    margin: 10px 0px 10px 0px;
    padding: 0;
    color: white;

    gap: 15px;
    width: 100%;
  }

  .Project .Links a img, .Project .Links a svg {
    border: 1px solid #eeeeee27;
    width: 32px;
    height: 32px;
    color: white;
    border-radius: 10px;
    padding: 6px;
    transition: 0.3s;
    fill: #9da8ad;
    background: #6b6b6b2c;
    object-fit: contain;
  }

  .Project .Links a img:hover ,
  .Project .Links a svg:hover {
    background: #0f579238;
    border: 1px solid #13a9ee4f;
    fill: #00b7ffd3;
    box-shadow: 0 0 10px #00aeff33;

  }

  .Project .Links a.details {
    color: #2c2e37;
    color: #1e1f24;
    color: rgba(255, 255, 255, 0.95);
    display: flex;
    justify-content: center;
    gap: 10px;
    font-family: "Roboto", sans-serif;
    text-decoration: none;
    font-weight: 400;
    font-family: "Roboto";
    font-size: 16px;
    transition: 0.3s;
    padding: 12px;
    margin: 0;
    width: calc(100% - 32px);
    border-radius: 10px;
    /*
    background-color: #0ea5e9;
    background-color: #0492d4;*/
    background: linear-gradient(to right, #0481d4, #00a5ce);
    background: linear-gradient(to right, #383f46, #4e5862, #4e5862, #0481d4, #0481d4, #00a5ce);
    background-size: 300% ;
  }

  .Project .Links a.details span {
    transition: 0.3s;
  }
  .Project .Links a.details:hover {
    /*background-color: rgba(0, 133, 173, 0.1);
    background: rgba(0, 133, 173, 0.2);*/
    box-shadow:
      0 0 24px 0 #00b7ff0e,
      0 2px 24px 0 #00b7ff0e;
    color: #00b7ff;
    color: white;
    gap: 10px;
    transition: 0.2s;
  }

  .Project:hover .Links a.details{
    transition: background-position 0.2s ease-in-out;
        background-position: 100%;

  }

  .Project .Links a.details:hover span {
    transform: translateX(10px);
  }

  .Project .Links a.details span {
    font-family: "WDXL Lubrifont TC", sans-serif;
    font-weight: 800;
  }

  .Project p {
    margin: 10px 32px 15px 0px;
    font-family: "Roboto";
    font-size: 17px;
    color: rgba(255, 255, 255, 0.7);
    font-weight: 400;
    line-height: 135%;
    word-spacing: 5%;
    text-shadow: #00000041 0px 0px 5px;
  }

  .Project .Links li {
    position: relative;
    list-style-type: none;
  }

  a.moreProjects {
    width: fit-content;
    background-color: var(--containerBg);
    border: solid 1px #ffffff1f;
    border: solid 1px #03bce4;
    color: #00b7ff;
    padding: 15px 35px;
    font-family: "Roboto", sans-serif;
    font-weight: 600;
    font-size: 18px;
    border-radius: 15px;
    cursor: pointer;
    transition: 0.3s;
    text-decoration: none;
    margin-top: 20px;
    margin-bottom: 0;
    align-items: center;
  }
  a.moreProjects:hover {
    background-color: rgba(0, 133, 173, 0.1);
    color: #00b7ff;
    border: solid 1px #03bce4;
    box-shadow:
      0 0 24px 0 #00b7ff0e,
      0 2px 24px 0 #00b7ff0e;
    transition: 0.2s;
    transform: translateY(-5px);
  }

  @media (max-width: 1024px) {
    .Project {
      width: 95%;
    }
  }

  @media (max-width: 768px) {
    #Projects-Items {
      padding: 10px 3px;
      gap: 30px 5%;
    }
    .Project {
      width: 100%;
    }
    .Project img.Project-Image {
      width: calc(100% - 18px);
      margin-top: 9px;
    }

    .Project .Content {
      width: calc(100% - 30px);
      padding: 15px;
    }
    .Project h3 {
      font-size: 22px;
    }
    .Project p {
      font-size: 18px;
    }
  }


</style>
