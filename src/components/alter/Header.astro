---
import type { RecordType } from "astro:schema";

import {globalUrl} from "../../utils/urls.js";

import {Calendar} from "@lucide/astro";

const { class: ClassName = "", project } = Astro.props;

const headerBackgroundImageUrl = `url(${globalUrl + project.image})`;

const itemsIcons: Record<string, string> = {
  url: "/img/icons/link.png",
  github: "/img/github-img.png",
  download: "/img/download.png",
};

const itemsNames: Record<string, string> = {
  url: "Visitar",
  github: "Github",
  download: "Descargar",
};
const totalItems = ["url", "github"];



const Items = totalItems.filter((item) => project.links[item]);

const linksDisplay = Items.length > 0 ? "flex" : "none";
---

<header class={ClassName + " fade-up"} >
  <div class="content">
    <span><Calendar size="18" /> {project.date}</span>
    <h1><span>{project.name} - {project.tagline}</span></h1>
    <p>
      {project.summary}
    </p>
  </div>
  <div class="relatives"  style={{ display: linksDisplay }}>
    <span >Enlaces</span>
    {Items.map((Item : string) => {
      return (
        <a
          href={project.links[Item]}
          target="_blank"
          rel="noopener noreferrer"
        >
          <img src={globalUrl + itemsIcons[Item]} alt={Item} />
          {itemsNames[Item]}
        </a>
      );  
    })}
    
  </div>
</header>

<span class="separator fade-up"></span>
<style define:vars={{ headerBackgroundImageUrl }}>
  header {
    background-color: rgba(51, 52, 57, 0.8); /* Añadir algo de transparencia */
    background-color: #373a469d;
    width: 1000px;
    height: 280px;
    margin: 20px auto 0 auto;
    padding: 15px 30px 5px 30px;
    display: flex;
    gap: 20px;
    color: #00a6ca;
    align-items: center;
    font-weight: 400;
    font-family: "Roboto", monospace;
    position: relative;
    z-index: 1;
    overflow: hidden; /* Para que no se desborde el ::before */
    border-radius: 10px;
    border: 1px solid #f4fdff0e;
    max-width: calc(100% - 60px);
    max-height: 1000px;
  }
  @media (max-width: 1000px) {
    header{
      padding-bottom: 75px;
    }
  }
  header::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: linear-gradient(
        to right,
        rgba(0, 0, 0, 0.55),
        rgba(0, 0, 0, 0.35)
      ),
      var(--headerBackgroundImageUrl);
    background-size: cover;
    background-position: center;
    filter: blur(15px);
    z-index: 0;
    opacity: 0.18; /* si usás fondo oscuro semi-transparente, podés mantener esto en 1 */
    pointer-events: none;
  }

  /* Aseguramos que el contenido del header esté por encima del ::before */
  header * {
    position: relative;
    z-index: 1;
  }
  header .content {

    max-width: 90%;
  }


  header h1 {
    font-size: 36px;
    max-width: fit-content;
    font-weight: 600;
    color: rgb(0, 171, 238);
    text-align: left;
    transition: 0.4s;
    text-shadow: #0000003d 1px 1px 05px;
    padding: 0px 0;
    margin: 0;
  }
  
  header h1 span {
    font-size: inherit;
    line-height: 0 ;
    font-weight: inherit;
    text-shadow: none;
  filter: drop-shadow(2px 2px #333);
    background: linear-gradient(to right,#008cff, #05c6f7);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  header p,
  header span {
    text-align: left;
    opacity: 1;
    text-shadow: #27282c 1px 1px 05px;
    letter-spacing: normal;
    line-height: 150%;
    font-weight: 400;
    font-size: 19px;
  }
  header span {
    font-weight: 600;
  }
  
  header p {
    color: rgb(226, 226, 226);
  }

  header .relatives {
    background-color: #1b1d2293;
    background-color: rgba(8, 24, 29, 0.5);
    border-radius: 10px;
    width: fit-content;
    border: 1px solid #f4fdff38;
    border: 1px solid #00a9dd;
    height: fit-content;
    padding: 10px;
    display: flex;
    flex-direction: column;
  }

  header .relatives span {
    font-size: 20px;
    font-weight: 600;
    justify-content: center;
    color: #ffffffbd;
    text-align: center;
    margin: 0 auto 10px auto;

  }

  header .relatives a {
    color: #03bce4;
    text-decoration: none;
    display: flex;
    font-weight: 600;
    align-items: center;
    border-radius: 5px;
    margin: 0 auto 5px auto;
    border: 1px solid transparent;
    padding: 12px 8px;
    transition: 0.2s;
    font-size: 16px;
  }

  header .relatives a:hover {
    color: #00a6ca;
    border: 1px solid #00a6ca;
    scale: 1.05;

    background-color: #00e1ff1f;
  }

  header .relatives a img {
    margin-right: 12px;
    height: 22px;
  }

  span.separator {
    display: block;
    width: 1000px;
    height: 3px;

    background-color: #373a46bd;
    margin: 25px auto;
    border-radius: 10px;
    max-width: 100%;
  }

  @media (max-width: 767px){
    header {
      max-width: calc(100% - 40px);
      padding: 20px;
      height: auto;
      margin: inherit auto;
      flex-direction: column;
      gap: 10px;
    }
      header .content {

    max-width: 95%;
  }

    header .relatives {
      max-width: calc(100% - 40px);
      width: calc(100% - 40px);
      padding: 10px;
      margin: 0 auto;
      display: inline-flex;
      flex-direction: row;
      gap: 20px;
      flex-wrap: wrap;
    }

    header .relatives span{
      vertical-align: middle;
      align-self: center;
      width: 100%;
    }
  }
</style>
