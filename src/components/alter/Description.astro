---
import ImagePopup from "../elements/ImagePopup.astro";
import {globalUrl} from "../../utils/urls.js";
import data from "../../data/projects.json";


const { project } = Astro.props;
type DescriptionItem =
  | { type: "text"; value: string; icon?: string }
  | { type: "img"; value: string }
  | { type: "list"; value: string[] }
  | { type: "demo"; value: any }
  | { type: "diagram"; value: string }
  | { type: "icon";  };


type Project = {
  key: string;
  name: string;
  tagline: string;
  image: string;
  summary: string;
  tecnologies: string[];
  description: Record<string, any>[];
  links: {
    url?: string;
    github?: string;
    download?: string;
  };
};
type Projects = Project[];

const allKeys = data.projects.map(project => project.key);
const currentIndex = allKeys.indexOf(project.key);
const prev = allKeys[currentIndex - 1] || allKeys[allKeys.length - 1];
const next = allKeys[currentIndex + 1] || allKeys[0];

const codeIcon = '<svg  viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="none"> <g stroke="#03bce4" stroke-linecap="round" stroke-width="1.75"> <path stroke-linejoin="round" d="M7 8l-4 4 4 4"/> <path d="M10.5 18l3-12"/> <path stroke-linejoin="round" d="M17 8l4 4-4 4"/> </g> </svg>';


const nutIcon = '<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" fill="#03bce4" version="1.1" id="mdi-nut" viewBox="0 0 24 24"><path d="M21,16.5C21,16.88 20.79,17.21 20.47,17.38L12.57,21.82C12.41,21.94 12.21,22 12,22C11.79,22 11.59,21.94 11.43,21.82L3.53,17.38C3.21,17.21 3,16.88 3,16.5V7.5C3,7.12 3.21,6.79 3.53,6.62L11.43,2.18C11.59,2.06 11.79,2 12,2C12.21,2 12.41,2.06 12.57,2.18L20.47,6.62C20.79,6.79 21,7.12 21,7.5V16.5M12,7A5,5 0 0,0 7,12A5,5 0 0,0 12,17A5,5 0 0,0 17,12A5,5 0 0,0 12,7Z"/></svg>'

const Icons = {
  codeIcon: codeIcon,
  nutIcon: nutIcon,
}

const diagram = "architecture-beta\ngroup cliente(cloud)[Cliente]\n  service navegador(internet)[Navegador] in cliente\n  service app(react)[React App] in cliente\n\ngroup servidor(server)[Servidor]\n  service api(server)[Nodejs API] in servidor\n  service db(database)[PostgreSQL DB] in servidor\n  service drive(disk)[Google Drive] in servidor\n\nservice usuario(person)[Usuario]\n\nusuario:R -- L:navegador\nnavegador:B -- T:app\napp:R -- L:api\napi:B -- T:db\napi:B -- T:drive\n";

const diagramJumpLine = diagram.split("\n").map((line, index) => {
  if (index === 0) {
    return line.replace("architecture-beta", "graph TD;");
  }
  return line;
}).join("\n");

---

<section id="Description">
  {/*<div class="Separator"></div>*/}

  {
    project.description.map((key: DescriptionItem) => {
      return (
        <p>
          {key.type === "text" && <p class="fade-up">{key.icon && <span class="icon" set:html={Icons[key.icon as keyof typeof Icons]}>{key.icon} </span>} {key.value}</p>}
          {key.type === "img" && (
            <ImagePopup
              thumbnailSrc={globalUrl + key.value}
              fullSrc={globalUrl + key.value}
              alt={`Imagen del proyecto ${project.name}`}></ImagePopup>
          )}
          {key.type === "list" && (
            <ul class="fade-up">
              {key.value.map((li, idx) => (
                <li>{li}</li>
              ))}
            </ul>
          )}
          {key.type === "demo" && (
            <h2 class="fade-up">Demo</h2>
            <div class="iframeContainer fade-up" set:html={key.value}>          
            </div>
          )}
          {key.type === "diagram" && (
            <ul class="fade-up diagram">
              <h2>Diagrama de Arquitectura</h2>
              <!-- <div class="mermaid">{key.value}</div>-->
        
              <div class="mermaid">
architecture-beta
group cliente(cloud)[Cliente]
  service navegador(internet)[Navegador] in cliente
  service app(catppuccin:javascript-react)[React App] in cliente

group servidor(server)[Servidor]
  service api(server)[Nodejs API] in servidor
  service db(database)[PostgreSQL DB] in servidor
  service drive(disk)[Google Drive] in servidor

service usuario(person)[Usuario]

usuario:R -- L:navegador
navegador:B -- T:app
app:R -- L:api
api:B -- T:db
api:B -- T:drive

              </div>
            </ul>
          )} 

 
        </p>
      );
    })
  }
  <!-- Demo <h1>Demo app</h1>
  <div class="iframeContainer">
    <iframe
      src="https://drive.google.com/file/d/1AyNGJabNyvOzS06BFfWQ2UCc_a4iLCna/preview"
      allow="autoplay"
      onload="resizeIframe(this);"></iframe>
  </div>-->
    <p class="buttons-title fade-up">Ver mas proyectos</p>

  <div class="buttons">
    <a href={`${globalUrl}projects/${prev}`} class="button fade-up" target="_blank" style="--i: 0">
      <img src={`${globalUrl}img/left-arrow.svg`} alt="Anterior" />
      Anterior
    </a>
    <a href={`${globalUrl}projects`} class="button fade-up" style="--i: 1">Ver Todos</a>
    <a href={`${globalUrl}projects/${next}`} class="button fade-up" style="--i: 2">Siguiente
     <img src={`${globalUrl}img/right-arrow.svg`} alt="Anterior" />
    </a>
  </div>

</section>
<style>

  #Description {
    margin: 20px auto;
    /* Ajusta según sea necesario */
    padding: 10px 20px 20px 20px;
    border-radius: 10px;
    max-width: 1000px;
    width: calc(100% - 40px);
  }

  #Description h1 {
    font-size: 50px;
    font-weight: 600;
    font-family: "Roboto";
    color: rgb(0, 171, 238);
    transition: 0.4s;
    padding: 0px 0;
    margin: 0;
  }

  #Description h2{
    font-size: 30px;
    font-weight: 500;
    font-family: "Roboto";
    color: #00a6ca;
    transition: 0.4s;
    padding: 0px 0;
    margin: 0;
  }

  #Description h1 span {
    color: white;
  }

  #Description h1:hover {
    white-space: 10px;
    text-indent: 8px;
    transition: 0.2s;
    text-shadow: #00d0ff3d 1px 1px 05px;
  }

  #Description p,
  #Description li {
    font-size: 19px;
    font-weight: 400;
    font-family: "Roboto";
    color: #ebfdff;
    margin: 0;
    padding: 0;
    line-height: 150%;
    letter-spacing: normal;
  }

  #Description li::marker{
    color: #54ceffb0;
    font-weight: 600;
    font-size: 1.2rem;
  }

  #Description ul {
    background-color: rgba(0, 0, 0, 0.095); /**/
    background-color: rgba(255, 255, 255, 0.035);
    background: #373a469d;
    background: var(--containerBg);
    margin-bottom: 45px;
    padding: 20px 20px 20px 45px;
    border-radius: 15px;
    border: 1px solid #f4fdff0e;
  }

  #Description ul.diagram{
    padding: 40px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  #Description ul.diagram h2 {
    font-size: 1.5rem;
    font-weight: 500;
    color: white;
    margin-bottom: 20px;
    text-align: center;
  }

  #Description ul.diagram .mermaid {
    width: 100%;
    display: flex;
    justify-content: center;
    padding: 0px;
  }

  #Description ul.diagram .mermaid > svg{
    min-width: 100%;
  }

  #Description ul ul {
    background-color: #27282c;
    padding: 10px 10px 10px 40px;
    border: 1px solid #f4fdff34;
    border-radius: 20px;
    margin: 15px 5px 5px 5px;
  }

  #Description ul ul li b {
    color: #a8f2ff;
  }

  #Description li b {
    color: rgb(49, 162, 255);

    font-size: 1.35rem;
    font-weight: 400;
  }

  #Description li {
    margin: 10px 0;
    opacity: 1;
    color: rgba(255, 255, 255, 0.95);
    font-weight: 300;
    transition: 0.3s;
  }

  #Description li:hover {
    transform: translate(10px, 0);
    transition: 0.2s;
  }

  #Description li:hover::marker {
    color: #00b7ff;
    font-weight: 800;
  }

  #Description img {
    width: 100%;
    height: auto;
    border-radius: 10px;
    margin: 20px 0%;
    transition: 0.3s;
    pointer-events: none;
  }

  #Description img:hover {
    transform: scale(1.025);
    transition: 0.2s;
    border-radius: 15px;
    box-shadow: #006fca 0px 0px 15px -5px;
  }

  .iframeContainer iframe {
    width: 100%!important;
    height: 500px;
    margin: 20px 0;
    border: none;
    border-radius: 10px;
    box-shadow: #006fca 0px 0px 15px -5px;
  }
  .iframeContainer {
  position: relative;
  width: 100%;
  padding-bottom: 56.25%; /* 16:9 ratio */
  height: 0;
  overflow: hidden;
  border-radius: 12px;
  box-shadow: 0 0 12px #0005;
  margin: 1rem 0;
}
#Description p.buttons-title{
  font-size: 1.5rem;
  font-weight: 600;
  color: white;
  margin-top: 35px;
  text-align: center;
  transition: 0.2s;
}

.buttons{
  margin-top: 15px;
  width: 100%;
  display: flex;
  gap: 20px;
  justify-content: center;
}

.buttons a.button{
    background: #373a469d;
    background: linear-gradient(to right,#008cff, #05c7f79a);
    background: linear-gradient(to right,#0e5792a1, #00a2e27e);
    background-size: 300% ;
    background-position:  calc(var(--i) *   33%) center; ;
    drop-shadow: 0 0 12px #0005;
    margin-bottom: 45px;
    text-decoration: none;
    color:  #00b7ff;
    color: rgba(255, 255, 255, 0.95);

    text-justify: center;
    font-weight: 500;
    align-content: center;
    padding: 0px 30px;
    border-radius: 15px;
}

#Description .buttons a.button img{
  width: 50px;
  height: auto;
  margin: 0px;
  vertical-align: middle;
  transition: 0.2s;
}
.buttons a.button img:hover{
  transform: translateX(5px);
  transition: 0.2s;
}
.buttons a.button:hover{
 background-color: rgba(0, 133, 173, 0.1);
    box-shadow: 0 0 24px 0 #00b7ff0e, 0 2px 24px 0 #00b7ff0e;
    transition: 0.2s;
    filter: brightness(1.1);
    transform: translateY(-5px);
    cursor: pointer;
}

span.icon{
  width: 28px;
  height: 28px;
  background-color: rgba(0, 140, 255, 0.363);
  border-radius: 5px;
  margin-right: 4px;
  display: inline-flex;
  padding: 2px;
    transition: 0.2s;

  transform: translateY(6px);
}
span.icon:hover {
  background-color: rgba(0, 140, 255, 0.5);
  box-shadow: 0 0 24px 0 #00b7ff0e, 0 2px 24px 0 #00b7ff0e;
}

span.icon svg{
  max-width:5px;
  height: 5px;
  color: red;
  fill: red!important;
  background-color: red;
}
  
</style>
<style is:global>
  .iframeContainer {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%; /* Relación de aspecto 16:9 */
    height: 0;
    overflow: hidden;
    border-radius: 12px;
    box-shadow: 0 0 12px #0005;
    margin: 1rem 0;
  }

  .iframeContainer iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100% !important;
    height: 100% !important;
    border: none;
    border-radius: 10px;
    box-shadow: #006fca 0px 0px 15px -5px;
  }


.mermaid svg .node rect{
   rx: 10px;
  ry: 10px;
}

.mermaid rect.node-bkg{
  rx:10px;
}

.mermaid svg rect{
  rx:10px;
  transition: 0.2s;
  fill: linear-gradient(#008eec, #00b7ff)!important;


}

.mermaid rect:hover{
  filter: brightness(1.2);
  /* fill: #008eec!important; */
  fill-opacity: .9;
  box-shadow: 1px 1px 5px rgba(0, 195, 255, 0.333);

  cursor: pointer;
}

.mermaid tspan{
  pointer-events: none;
}

.mermaid line, .mermaid path, .mermaid polygon,.mermaid circle, .mermaid ellipse{
  pointer-events: none;
}
</style>