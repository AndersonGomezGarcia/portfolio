---
import Title from "../components/elements/Title.astro"; 
import SkillGroup from "./elements/SkillGroup.astro";
import data from "../data/main.json";

const Tecnologies = [
    "img/icons/html.png",
    "img/icons/css.png",
    "img/icons/js.png",
    "img/icons/git.png",
    "img/icons/php.png",
    "img/icons/csharp.png",
    "img/icons/sql.png"
];

const TecnologiesTags = [
    "HTML",
    "CSS",
    "JavaScript",
    "Git",
    "PHP",
    "C#",
    "SQL"
];

const Frameworks = [
    "img/icons/bootstrap.png",
    "img/icons/tailwind.png",
    "img/icons/react.png",
    "img/icons/dotnet.png",
    "img/icons/laravel.png",
    "img/icons/astro.png",
    "img/icons/angular.png"
];

const FrameworksTags = [
    "Bootstrap",
    "Tailwind",
    "React",
    ".NET",
    "Laravel",
    "Astro",
    "Angular"
];

const Tools = [
    "img/icons/figma.png",
    "img/icons/postgresql.png",
    "img/icons/xampp.png",
    "img/icons/github.png",
    "img/icons/vscode.png",
    "img/icons/postman.png"
];

const ToolsTags = [
    "Figma",
    "PostgreSQL",
    "XAMPP",
    "GitHub",
    "VS Code",
    "Postman"
];

---
<div id="Skills" class="fade-up section">

        <Title title={data.Skills.title} beforeTitle={data.Skills.pretitle} />
        <div class="Separator"></div>
        <SkillGroup  Group="Tecnologías" items={Tecnologies} tags={TecnologiesTags} />
        <SkillGroup Group="Frameworks" items={Frameworks} tags={FrameworksTags} />
        <SkillGroup Group="Tools" items={Tools} tags={ToolsTags} />
    </div>

     <style>
        #center{
    margin: auto;
}

#Tecnologies-Items ul, #Frameworks-Items ul, #Tools-Items ul{
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
    margin: auto;
    padding: 0;
    background-color: #27282C;
    background-color: var(--containerBg);
    color: white;
    width: auto;
    max-width: 700px;
    list-style: none;
}
#Tecnologies-Items ul li , #Frameworks-Items ul li , #Tools-Items ul li {
    position: relative;

}

#Tecnologies-Items ul li img, #Frameworks-Items ul li img, #Tools-Items ul li img{
    height: 57.5px;
    width: auto;
    margin: 0;
    padding: 0;
    transition: .3s;
}

#Tecnologies-Items ul li img:hover, #Frameworks-Items ul li img:hover, #Tools-Items ul li img:hover{
    filter: brightness(1.4); /* Ajusta el valor según el nivel de brillo deseado */
    transition:  .2s  ; /* Añade una transición suave */
    transform: translate(0, -8px);
}
#Skills .Separator, .Separator{
    width: 100%;
    height: 2px;
    background-color: #ffffff1f;
    color: transparent;
    margin: 20px 0 20px 0;
    border-radius: 2px;
}

#Skills h3{
    font-size: 35px;
    font-weight: 600;
    margin: 0 auto 0 auto;
    font-family: 'Roboto';
    color: #00D2FF;
    color: white;
    margin: 40px auto 0 auto;
}


#Tecnologies-Items, #Frameworks-Items, #Tools-Items{
    display: inline-flex;
    background-color: #2e2f35;
    background-color: var(--containerBg);
    color: white;
    border: solid 1px #ffffff1f ;
    border-radius: 40px;
    padding: 20px 30px;
    margin: 20px auto 0 auto;
    width:auto;
    max-width: 100%;
    transition: .4s;
    
    
    
}
#Tecnologies-Items:hover, #Frameworks-Items:hover, #Tools-Items:hover{
    border: solid 1px #03BCE4;
    transition: .2s;
    padding: 20px;
    max-width: calc(100% - 30px);
    background-color: rgba(0, 133, 173, 0.1);
}

#Tecnologies-Items ul li, #Frameworks-Items ul li, #Tools-Items ul li {
    position: relative; /* Necesario para posicionar el pseudo-elemento */
}
#Tecnologies-Items ul, #Frameworks-Items ul, #Tools-Items ul {
    background-color: transparent;
}
#Tecnologies-Items ul li img:hover::after, #Frameworks-Items ul li img:hover::after, #Tools-Items ul li img:hover::after {
    content: attr(alt); /* Usa el contenido del atributo alt */
    position: absolute;
    bottom: -30px; /* Ajusta la posición según sea necesario */
    left: 50%;
    transform: translateX(-50%);
    background-color: rgba(0, 0, 0, 0.7); /* Fondo semi-transparente */
    color: white;
    padding: 5px 10px;
    border-radius: 5px;
    white-space: nowrap; /* Evita que el texto se divida en varias líneas */
    z-index: 10; /* Asegura que el texto esté por encima de otros elementos */
    font-size: 14px;
    pointer-events: none; /* Evita que el pseudo-elemento interfiera con el hover */
}



#Tecnologies, #Frameworks, #Tools{
    display: flex;
    flex-direction: column;
}
    </style>