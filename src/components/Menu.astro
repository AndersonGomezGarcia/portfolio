---
import def_data from "../data/main.json";
import en_data from "../data/en/main.json";
import es_data from "../data/es/main.json";

import { globalUrl } from "../utils/urls.js";

const { lan } = Astro.props;

let data;
if (lan) {
  if (lan === "en") {
    data = en_data;
  } else {
    data = es_data;
  }
} else {
  data = def_data;
}
---

<div id="Menu">
  <div id="hamburger" class="hamburger" onclick="toggleMenu()">☰ Menu</div>
  <nav class="menu" id="nav-menu">
    <img src={globalUrl + "/img/icon.png"} alt="programador" />
    <li>
      <a
        class="scroll-link"
        href="#About"
        onclick="toggleMenu()"
        aria-label="view about me">{data.menu.about}</a
      >
    </li>
    <li>
      <a
        class="scroll-link"
        href="#Projects"
        onclick="toggleMenu()"
        aria-label="View my projects">{data.menu.projects}</a
      >
    </li>
    <li>
      <a
        class="scroll-link"
        href="#Experience"
        onclick="toggleMenu()"
        aria-label="View my projects">{data.menu.experience}</a
      >
    </li>
    <li>
      <a
        class="scroll-link"
        href="#Contact"
        onclick="toggleMenu()"
        aria-label="Contact">{data.menu.contact}</a
      >
    </li>
    <div
      id="translate"
      data-globalurl={globalUrl}
      style={`background-image: url('${globalUrl}/img/traducir-hover.png'); background-size: cover; height: 40px; width: 40px; position: absolute; transition: 0.2s; right: 35px; top: calc(50% - 22px);`}
      onclick="changeLanguage()"
    >
    </div>
  </nav>
</div>

<script client:load>
  document.querySelectorAll(".scroll-link").forEach((anchor) => {
    anchor.addEventListener("click", function (e) {
      e.preventDefault();
      document.querySelector(this.getAttribute("href")).scrollIntoView({
        behavior: "smooth",
        block: "start",
      });
    });
  });

  function toggleMenu() {
    if (window.innerWidth <= 768) {
      // Verifica si el ancho de la pantalla es menor o igual a 768px

      var menu = document.getElementById("nav-menu"); /*as HTMLElement | null*/
      var hamburger = document.getElementById("hamburger");

      if (!menu || !hamburger) {
        console.error("Menu or hamburger element not found");
        return;
      }
      if (menu.style.display === "block") {
        menu.style.display = "none";
        hamburger.innerHTML = "☰ Menu";
      } else {
        menu.style.display = "block";
        hamburger.innerHTML = "✖ Close";
      }
    }
  }

  function changeLanguage() {
    const currentLang = document.documentElement.lang;
    const newLang = currentLang === "en" ? "es" : "en";
    //    document.documentElement.lang = newLang;
    const translate = document.getElementById("translate");
    const globalUrl = translate.dataset.globalurl;
    console.log("Changing language to:", newLang, "in", globalUrl);
    window.location.href = globalUrl + `./${newLang}/`;
    // Aquí puedes agregar lógica para cargar el contenido en el nuevo idioma
  }

  // --- Config ---
  const headerOffsetPx = 64; // si tu header es más alto, súbelo
  document.addEventListener("DOMContentLoaded", () => {
    // Mapear secciones y links
    const links = Array.from(document.querySelectorAll("#Menu a"));
    /*const sections = links
      .map((a) => document.querySelector(a.getAttribute("href")))
      .filter(Boolean);
    console.log(links, sections);*/
    const sections = document.querySelectorAll(' #About, #Skills, #Contact, #Projects, #Experience');

    // Helper: activar link
    function setActive(id) {
      links.forEach((a) => {
        const isActive = a.getAttribute("href") === `#${id}`;
        a.classList.toggle("active", isActive);
        a.setAttribute("aria-current", isActive ? "true" : "false");
      });
    }

    const sectionAlias = {
      Skills: "About", // Cuando Skills está visible, marcá About como activo
      Hero: "About", // Ejemplo, si querés otros cambios
    };

    // IntersectionObserver con margen para considerar el header
    const io = new IntersectionObserver(
      (entries) => {
        console.log("IO created");

        // Elegimos la sección con mayor intersección visible
        let best = null;
        for (const e of entries) {
          if (!best || e.intersectionRatio > best.intersectionRatio) best = e;
        }
        if (best && best.isIntersecting) {
          let id = best.target.id;

          console.log("Active section changed to:", id);
          // Si esa sección tiene alias, usar el alias
          if (sectionAlias[id]) {
            id = sectionAlias[id];
          }

          setActive(id);
        }
      },
      {
        root: null,
        threshold: [0, 0.25, 0.5, 0.75, 1],
        // top negativo = ignora la franja tapada por el header
        rootMargin: `-${headerOffsetPx}px 0px -50% 0px`,
      }
    );
    sections.forEach((s) => io.observe(s));

    // Fallback por si IO no existe
    if (!("IntersectionObserver" in window)) {
      const onScroll = () => {
        const y = window.scrollY + headerOffsetPx + window.innerHeight * 0.3;
        let current = sections[0].id;
        sections.forEach((sec) => {
          const top = sec.offsetTop;
          if (y >= top) current = sec.id;
        });
        setActive(current);
      };
      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();
    }

    sections.forEach((s) => io.observe(s));
  });
</script>
<style>
  #Menu {
    color: white;
    padding: 2px 70px;
    text-align: center;
    border-radius: var(--containerBR);
    height: 55px;
    margin: 8px auto 0 auto;
    top: 0;
    max-width: 1100px;
    width: calc(100% - 140px);
    align-items: center;
    position: fixed;
    display: flex;
    border: solid 1px #ffffff0e;
    backdrop-filter: blur(9px);
    z-index: 1000;
    left: calc(50% - 620px);
    background-color: rgba(46, 47, 56, 0.85);
    background-color: #262a2eb6;
  }

  nav {
    display: flex;
    justify-content: center;
    align-self: center;
    margin: auto;
    flex-wrap: wrap; /* Permite que los elementos se envuelvan en varias líneas */
  }

  @keyframes jump {
    0% {
      transform: translateY(0) scale(0.9) rotate(10deg); /* Posición inicial y final */
    }
    25% {
      transform: translateY(-2px) rotate(10deg); /* Altura del salto */
    }
    50% {
      transform: translateY(0) scale(0.9) rotate(-10deg);
    }
    75% {
      transform: translateY(-2px) rotate(10deg);
    }

    100% {
      transform: translateY(0) scale(0.9) rotate(10deg);
    }
  }

  nav img {
    height: 35px;
    width: auto;
    position: absolute;
    top: calc(50% - 14px);
    left: 55px;
    animation: jump 1s ease-in-out infinite;
  }

  nav li {
    list-style: none;
    margin: 0 20px; /* Reduce el margen para pantallas más pequeñas */
    position: relative;
    padding: 10px;
    transition: 0.4s;
  }

  nav li::before {
    content: "";
    width: 100%;
    height: 40px;
    position: absolute;
    left: 0;
    top: 0px;
    border-radius: 12px;
    transition: 0.2s ease-in-out;
    transform: scale(0.8);
    border: solid 0px #ffffff0e;
  }

  .hamburger {
    display: none;
  }
  /*
nav li:hover {
    background-color: rgba(0, 0, 0, 0.20);
    transition: .3s;
}*/
  nav li:hover::before {
    background-color: rgba(255, 255, 255, 0.05);
    transition: 0.1s ease-in;
    transform: scale(1);
    border: solid 1px #ffffff0e;
  }
  nav li:not(:nth-last-child(-n + 2))::after {
    content: "";
    position: absolute;
    right: -20px; /* Ajusta según el margen */
    top: 50%;
    transform: translateY(-50%);
    height: 25px; /* Ajusta según tus necesidades */
    width: 3px; /* Grosor del separador */
    border-radius: 2px;
    background-color: #ffffff6b; /* Color del separador */
  }

  nav li a {
    color: #03bce4;
    color: white;
    text-decoration: none;
    font-size: 17px;
    font-family: "Roboto";
    position: relative;
    font-weight: 400;
    transition: 0.35s ease-in;
    padding: 8px 20px; /* Reduce el padding para pantallas más pequeñas */
  }

  nav li a.active {
    color: #b9e9ff;
    filter: drop-shadow(
      0 0 5px #03bbe45d
    ); /* Aplica un brillo del color del icono */
    transition: 0.25s; /* Añade una transición suave */
  }
  nav li a::after {
    opacity: 0;
    content: "";
    position: absolute;
    left: 50%;
    bottom: 0px;
    transform: translateX(-50%);
    height: 3px;
    width: 10px;
    background-color: #00d2ff;
    border-radius: 2px;
    transition: 0.35s ease-in;
  }

  nav li a.active::after {
    opacity: 1;
  }

  nav li:hover a {
    filter: drop-shadow(
      0 0 5px #03bbe488
    ); /* Aplica un brillo del color del icono */
    transition: 0.15s; /* Añade una transición suave */
  }

  nav #translate {
    background-size: cover;
    background-image: url("/img/traducir-hover.png");
    height: 40px;
    width: 40px;
    content: "";
    position: absolute;
    transition: 0.2s;
    right: 35px;
    top: calc(50% - 22px);
  }

  #translate:hover {
    background-image: url("/img/traducir-hover.png");
    filter: drop-shadow(
      0 0 5px #03bbe4
    ); /* Aplica un brillo del color del icono */
    transition: 0.2s;
    cursor: pointer;
  }

  /* Media queries para pantallas más pequeñas */
  @media (max-width: 1110px) {
    #Menu {
      width: 82%; /* Ajusta el ancho del menú */
      padding: 2px 20px; /* Reduce el padding */
      left: calc(9% - 21px); /* Ajusta la posición del menú */
    }

    nav li {
      margin: 0 10px; /* Reduce el margen */
    }

    nav li:not(:last-child)::after {
      right: -10px; /* Ajusta según el margen */
    }

    nav li a {
      padding: 10px 10px; /* Reduce el padding */
    }
  }

  @media (max-width: 860px) {
    #Menu {
      width: calc(100% - 42px); /* Ajusta el ancho del menú */
      padding: 2px 20px; /* Reduce el padding */
      left: 0;
    }

    nav li {
      margin: 0 10px; /* Reduce el margen */
    }

    nav li:not(:last-child)::after {
      right: -10px; /* Ajusta según el margen */
    }

    nav li a {
      padding: 10px 10px; /* Reduce el padding */
    }

    .hamburger {
      cursor: pointer;
      font-size: 24px;
    }
  }

  @media (max-width: 768px) {
    body {
      padding: 0 7% 0 7%;
    }
    #Menu {
      position: fixed;
      height: auto;
      display: block;
      width: 100%;
      padding: 10px 0;
      margin: 0;
      top: 0;
    }

    nav li {
      margin: 14px auto;
      width: fit-content;
    }

    nav li:not(:last-child)::after {
      content: "";
      position: absolute;
      right: 10%; /* Ajusta según el margen */
      top: 115%;
      transform: translateY(-50%);
      height: 3px; /* Ajusta según tus necesidades */
      width: 80%; /* Grosor del separador */
      border-radius: 2px;
      background-color: #03bce4; /* Color del separador */
    }
    nav li a {
      padding: 10px 50px;
    }
    #Front-Left h1 {
      font-size: 35px;
    }
    button.Contact,
    #Front-Left-1 a p {
      font-size: 22px;
    }
    .menu {
      display: none;
      flex-direction: row;
      position: static;
    }
    .hamburger {
      display: block;
      width: 100%;
    }
    .menu a {
      padding: 10px 20px;
    }
  }
</style>
