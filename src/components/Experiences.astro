---
import Title from "../components/elements/Title.astro";
import data from "../data/main.json";
---

<div id="Experience " class="fade-up">
        <Title title={data.experience.title} beforeTitle={data.experience.pretitle} />
        <div class="Separator"></div>
        <div id="Experience-Items">
            { data.experience.experiences.map( (experience, index) => (
                <div class="Experience fade-up" key={index}>
                    <div class="ball"></div>
                    <h3>{experience.title} <span>{experience.datetime}</span></h3>
                    <p>{experience.description}</p>
                    {/*<div class="Separator" style="width: 90%;"></div>*/}
                </div>
            ))}
        </div>

   <style>
    #Experience-Items{
    gap: 20px 0;
    display: flex;
    margin: 25px 0 0 0;
    flex-direction: column;
    /*background-color: var(--containerBg);
    border-radius: 15px;
    border: solid 1px #ffffff1f;*/
}

.Experience{
    display: flex;
    flex-wrap: wrap;
    margin: 0 0 0px 35px;
    gap: 20px;
    flex-direction: column; 
    padding: 30px 5px 30px 20px;
    position: relative;
    transition: .4s;
    border: solid 1px transparent ;
    border-radius: 12px ;
    background-color: var(--containerBg);
    border-radius: 15px;
        border: solid 1px #ffffff1f;

*/
}
.Experience:hover{
    background-color: rgba(255,255,255,0.045);
    transition: .2s;
    border: solid 1px #ffffff1f ;
    border: solid 1px #03bce4;
    background-color: rgba(0, 133, 173, 0.15);

}

@keyframes goteoAnimacion {
    20% {
        background-color: #00D2FF;
    }
    20%, 100% {
        transform: scale(1.5);
        opacity: 1;
        
    }
    70% {
        transform: scale(2);
        background-color: inherit;
        opacity: 1;
    }
}

@keyframes ondasAnimacion {
    00% {
        transform: scale(1);
        opacity: 0.5;
    }
    50% {
        transform: scale(3);
        opacity: 0;
    }
    100% {
        transform: scale(1);
        opacity: 0;
    }
}

#Experience-Items .Experience:first-child .ball, #Experience-Items .Experience:first-child .ball::before {
    animation-delay: 1.2s;
}

#Experience-Items .Experience:nth-child(2) .ball, #Experience-Items .Experience:nth-child(2) .ball::before {
    animation-delay: .8s;
}

#Experience-Items .Experience:nth-child(3) .ball, #Experience-Items .Experience:nth-child(3) .ball::before {
    animation-delay: 0.4s;
}

.Experience .ball {
    content: ""; /* Asegúrate de que el pseudo-elemento tenga contenido */
    display: block; /* Asegúrate de que el pseudo-elemento sea un bloque */
    height: 8px;
    width: 8px;
    border-radius: 10px;
    position: absolute; /* Posiciona el pseudo-elemento absolutamente */
    left: -35px;
    top: 17px; /* Ajusta la posición según sea necesario */
    top: 40px;
    background-color: #00D2FF;
    background-color: var(--containerBg);
    background-color: #232d35!important;
box-shadow: 0 0 0 1px #00D2FF inset;
    animation: goteoAnimacion 1.5s infinite;
    z-index: 5;
}
.Experience .ball::before{
    content: ""; /* Asegúrate de que el pseudo-elemento tenga contenido */
    display: block; /* Asegúrate de que el pseudo-elemento sea un bloque */
    height: 8px;
    width: 8px;
    z-index: 1;

    border-radius: 5px;
    position: absolute; /* Posiciona el pseudo-elemento absolutamente */
    left: 0px;
    top: 0px; /* Ajusta la posición según sea necesario */
    background-color: #00D2FF;
    animation: ondasAnimacion 1.5s infinite;

}
.Experience::before::after{
    content: ""; /* Asegúrate de que el pseudo-elemento tenga contenido */
    display: block; /* Asegúrate de que el pseudo-elemento sea un bloque */
    height: 8px;
    width: 8px;
    border-radius: 5px;
    position: absolute; /* Posiciona el pseudo-elemento absolutamente */
    left: -30px;
    top: 0px; /* Ajusta la posición según sea necesario */
    background-color: #00D2FF;
    z-index: 1;
    animation: goteoAnimacion 1s infinite;
}

.Experience::after {
    content: ""; /* Asegúrate de que el pseudo-elemento tenga contenido */
    display: block; /* Asegúrate de que el pseudo-elemento sea un bloque */
    height: calc(100% - 35px);
    height: calc(100% + 25px);
    width: 2px;
    position: absolute; /* Posiciona el pseudo-elemento absolutamente */
    left: -32px;
    top: 17px; /* Ajusta la posición según sea necesario */
    top: 40px;
    background-color: #00d0ff5d;
    opacity: .5;
    border-radius: 2px;
    transition: .4s;
}

.Experience:last-child::after{
    height: calc(100% - 60px);
}
@keyframes sliding{
    0%{
        height: original;
    }
    50%{
        height: calc(80% - 35px);
    }
    100%{
        height: original;
    }
}
.Experience:hover::after{
    opacity: .8;
    /*animation: sliding .65s ease-in-out infinite;*/
    height: calc(50%);
}

.Experience:has(+ .Experience:hover)::after {
  opacity: .8;
  height: 75%;
}
.Experience h3{
    font-size: 25px;
    font-weight: 600;
    font-family: 'Roboto';
    color: #00D2FF;
    color: rgb(211, 211, 211);
    margin: 0;
}

.Experience h3 span{
    font-size: 20px;
    font-weight: 400;
    font-family: 'Roboto';
    color: #00D2FF;
    margin: 0 0 0 10px;
    font-style: italic;
    text-decoration: underline;
    text-decoration: underline;
    opacity: .75;
}

.Experience h4{
    color: #0FA2C1;
    position: relative;
}

.Experience p{
    color: #B3BDC7;
    font-size: var(--paragraph-font-size, 20px);
    margin: 0px 0 -10px 0;
}
   </style>